---
import BaselineBadge from "./BaselineBadge.astro";
import { recipes } from "../lib/recipes";
import { transformationFor } from "../lib/transformations";

const coverage = [
  "Layout and containment",
  "Selectors and state",
  "Logical properties",
  "Forms and controls",
  "Dialogs and overlays",
  "Colour and theming",
  "Motion and reduced motion",
  "Native web APIs",
];
---

<section aria-labelledby="examples-heading" id="examples">
  <div class="section-bar">
    <h2 id="examples-heading">
      Five examples. One way of thinking. <span>RUNNABLE EXAMPLES</span>
    </h2>
    <p>Try the outcomes, then inspect the decisions.</p>
  </div>
  <div class="gallery">
    {recipes.map((recipe, i) => {
      const transformation = transformationFor(recipe.id);
      return (
        <article class:list={["recipe", recipe.id]} id={recipe.id}>
          <div class="recipe-top">
            <code>{recipe.feature}</code>
            <span class="category">{recipe.category}</span>
          </div>
          <div class="demo">
            <iframe
              loading={i < 2 ? "eager" : "lazy"}
              sandbox="allow-scripts"
              srcdoc={recipe.embedded}
              title={`${recipe.title} demo`}
              transition:animate="none"
            ></iframe>
          </div>
          <div class="recipe-info">
            <p class="interaction">{recipe.action}</p>
            <h3>
              <a href={`/recipes/${recipe.id}/`}>{recipe.title}</a>
              <span aria-hidden="true" class="recipe-go">
                →
              </span>
            </h3>
            <p>{recipe.description}</p>
            {transformation && (
              <p class="recipe-reduction">
                <strong>What goes:</strong> {transformation.removes}
              </p>
            )}
            <div class="recipe-meta">
              <BaselineBadge status={recipe.status} />
              <a href={`/recipes/${recipe.id}/`}>
                See the full decision <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      );
    })}
    <aside class="collection-note">
      <span aria-hidden="true" class="note-symbol">
        {"{ }"}
      </span>
      <p class="eyebrow">THE THINKING, MADE TANGIBLE</p>
      <h3>
        Five runnable here.
        <br />
        Not five capabilities.
      </h3>
      <p>
        These examples let you try the interaction and inspect the decision. In
        a real project the skill reads your framework, tokens, browser targets,
        and existing behavior before it proposes a change.
      </p>
      <ul class="coverage">
        {coverage.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
      <a
        class="text-link"
        href="https://modern-css.com/reference/interop-2027/"
      >
        Explore a source of platform possibilities{" "}
        <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </div>
  <p class="support-note">
    Support reviewed 14 September 2026. Baseline is a starting point; the skill
    checks your browser targets and the exact features in use. Newly available
    recipes preserve a usable base.{" "}
    <a href="https://web.dev/baseline">About Baseline ↗</a>
  </p>
</section>
