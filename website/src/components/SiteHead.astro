---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  imageAlt?: string;
  type?: "article" | "website";
}

const {
  title,
  description,
  imageAlt = "Fewer Parts — same experience, fewer moving parts",
  type = "website",
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL("/social-card.png", Astro.site ?? Astro.url);
---

<meta charset="UTF-8" />
<meta content="width=device-width, initial-scale=1" name="viewport" />
<meta content={description} name="description" />
<link href={canonicalUrl} rel="canonical" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={type} property="og:type" />
<meta content="Fewer Parts" property="og:site_name" />
<meta content={canonicalUrl} property="og:url" />
<meta content={socialImageUrl} property="og:image" />
<meta content={imageAlt} property="og:image:alt" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
<meta content="image/png" property="og:image:type" />
<meta content="summary_large_image" name="twitter:card" />
<meta content={title} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={socialImageUrl} name="twitter:image" />
<meta content={imageAlt} name="twitter:image:alt" />
<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
<meta content={Astro.generator} name="generator" />
<title>{title}</title>
<ClientRouter />

<script>
  // The label is read once and parked on the element. Reading it live meant a
  // second press inside the restore window captured "Copied" as the original,
  // and the button never found its way back to "Copy code".
  const labelOf = (button: HTMLButtonElement) => {
    button.dataset.label ??= button.textContent?.trim() ?? "Copy";
    return button.dataset.label;
  };

  // Keyed by button, so two copy controls on one page keep their own timers and
  // a repeated press restarts its own rather than stacking a second restore.
  const restores = new WeakMap<HTMLButtonElement, number>();

  const flash = (
    button: HTMLButtonElement,
    message: string,
    announcement: string,
    holdMs: number
  ) => {
    const label = labelOf(button);
    const status = document.querySelector<HTMLOutputElement>("#copy-status");

    button.textContent = message;
    if (status) {
      status.textContent = announcement;
    }

    window.clearTimeout(restores.get(button));
    restores.set(
      button,
      window.setTimeout(() => {
        button.textContent = label;
        // Cleared as well as restored: leaving the last result in the live
        // region means an identical second copy announces nothing at all.
        if (status) {
          status.textContent = "";
        }
      }, holdMs)
    );
  };

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) {
      return;
    }

    const button = target.closest<HTMLButtonElement>("[data-copy]");
    if (!button) {
      return;
    }

    const sourceId = button.getAttribute("aria-controls");
    const source = sourceId ? document.getElementById(sourceId) : null;
    if (!source) {
      return;
    }

    try {
      await navigator.clipboard.writeText(source.textContent ?? "");
      flash(button, "Copied", "Copied to clipboard.", 1800);
    } catch {
      // Held longer than the success flash: this one is an instruction the
      // reader has to act on, not an acknowledgement they can ignore.
      flash(
        button,
        "Select to copy",
        "Copy unavailable. Select the visible text.",
        5000
      );
    }
  });
</script>
