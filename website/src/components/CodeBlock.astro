---
/* eslint-disable astro/no-set-html-directive -- TanStack Highlight escapes all source text. */
import { type CodeLanguage, highlightCode } from "../lib/highlight";

interface Props {
  /** Target of the toolbar's copy button; must be unique on the page. */
  id: string;
  source: string;
  label?: string;
  lang?: CodeLanguage;
}

const { id, source, label = "HTML", lang = "html" } = Astro.props;
const highlighted = highlightCode(source, lang);
---

<div class="code-panel">
  <div class="code-toolbar">
    <span>
      <i aria-hidden="true"></i>
      {label}
    </span>
    <button aria-controls={id} data-copy type="button">
      Copy code
    </button>
  </div>
  <!-- TanStack Highlight escapes source before returning this markup. -->
  <div class="highlighted-code" id={id} set:html={highlighted} />
</div>
