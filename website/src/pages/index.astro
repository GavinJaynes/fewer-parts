---
import CloudHero from "../components/CloudHero.astro";
import SiteHead from "../components/SiteHead.astro";
import { recipes } from "../lib/recipes";
import "../styles/site.css";
const installPrompt =
  "Use $modern-web-ui to build this interface with Tailwind where the project permits it, plus suitable native HTML and web APIs. Preserve the design and check the Tailwind version and browser targets.";
// Nav "Examples" opens the recipe index, which lands on the first example.
const examplesHref = `/recipes/${recipes[0].id}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      description="Try modern CSS and native web API recipes. Explore the code, check browser support, and give your coding agent the Modern Web UI skill."
      title="Modern Web UI — Native patterns for better interfaces"
    />
  </head>
  <body>
    <a class="skip" href="#examples">
      Skip to examples
    </a>
    <header class="site-header">
      <a
        aria-label="Modern Web UI home"
        class="brand"
        href="/"
        transition:name="site-brand"
      >
        <span aria-hidden="true" class="brand-mark">
          m<span>→</span>
        </span>
        modern web ui<span class="edition">/ skill</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={examplesHref}>
          Examples <span>{recipes.length}</span>
        </a>
        <a href="#approach">The approach</a>
        <a class="nav-install" href="#install">
          Get the skill <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main>
      <CloudHero />
      <section aria-labelledby="examples-heading" id="examples">
        <div class="section-bar">
          <h2 id="examples-heading">
            The collection <span>01—0{recipes.length}</span>
          </h2>
          <p>Real code. Ready to explore.</p>
        </div>
        <div class="gallery">
          {recipes.map((recipe, i) => (
            <article class:list={["recipe", recipe.id]} id={recipe.id}>
              <div class="recipe-top">
                <span class="recipe-number">0{i + 1}</span>
                <code>{recipe.feature}</code>
                <span class="category">{recipe.category}</span>
              </div>
              <div class="demo">
                <iframe
                  loading={i < 2 ? "eager" : "lazy"}
                  sandbox="allow-scripts"
                  srcdoc={recipe.embedded}
                  title={`${recipe.title} demo`}
                  transition:animate="none"
                ></iframe>
              </div>
              <div class="recipe-info">
                <p class="interaction">{recipe.action}</p>
                <h3 transition:name={`recipe-title-${recipe.id}`}>
                  <a href={`/recipes/${recipe.id}/`}>{recipe.title}</a>
                </h3>
                <p>{recipe.description}</p>
                <div class="recipe-meta">
                  <span
                    class:list={[
                      "support",
                      { newly: recipe.status === "Newly available" },
                    ]}
                  >
                    {recipe.status}
                  </span>
                  <a href={recipe.source}>
                    Support & docs <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <a class="view-example" href={`/recipes/${recipe.id}/`}>
                  View example <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
          <aside class="collection-note">
            <span aria-hidden="true" class="note-symbol">
              {"{ }"}
            </span>
            <p class="eyebrow">A SMALL COLLECTION, KEPT CURRENT</p>
            <h3>
              The platform keeps moving.
              <br />
              So do the possibilities.
            </h3>
            <p>
              These are the first recipes. The skill also consults live Modern
              CSS and MDN references to find the right pattern for your task.
            </p>
            <a class="text-link" href="https://modern-css.com/cheatsheet/">
              Explore the Modern CSS cheatsheet{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
        <p class="support-note">
          Support reviewed 14 September 2026. Baseline is a starting point;
          check your browser targets and the exact features you use. Newly
          available recipes preserve a usable base.{" "}
          <a href="https://web.dev/baseline">About Baseline ↗</a>
        </p>
      </section>
      <section
        aria-labelledby="approach-heading"
        class="approach"
        id="approach"
      >
        <div>
          <p class="eyebrow">THE APPROACH</p>
          <h2 id="approach-heading">Modern, with a reason.</h2>
        </div>
        <div class="principles">
          <div>
            <span>01</span>
            <h3>Start with the outcome.</h3>
            <p>
              Choose a native feature when it makes the interface simpler or
              more capable.
            </p>
          </div>
          <div>
            <span>02</span>
            <h3>Keep the whole interaction.</h3>
            <p>
              Preserve keyboard access, application state, and the behavior
              people depend on.
            </p>
          </div>
          <div>
            <span>03</span>
            <h3>Check what really works.</h3>
            <p>
              Read current sources. Test the result. Keep useful fallbacks for
              the browsers you support.
            </p>
          </div>
        </div>
      </section>
      <section aria-labelledby="install-heading" class="install" id="install">
        <div>
          <p class="eyebrow">FOR YOUR CODING AGENT</p>
          <h2 id="install-heading">
            Take the patterns
            <br />
            into your project.
          </h2>
          <p>
            A small skill with live references and the same runnable recipes you
            see here. Framework-aware, with no MCP server or API key required.
          </p>
          <a class="download" download href="/downloads/modern-web-ui.zip">
            Download the skill <span aria-hidden="true">↓</span>
          </a>
          <a class="repo-link" href="https://github.com/GavinJaynes/skills">
            View repository ↗
          </a>
        </div>
        <div class="install-steps">
          <h3>Install in your project</h3>
          <p>
            Extract the download and copy the complete{" "}
            <code>modern-web-ui</code> folder into:
          </p>
          <pre><code>.agents/skills/modern-web-ui/</code></pre>
          <p>Then ask your agent:</p>
          <div class="prompt">
            <p id="install-prompt">{installPrompt}</p>
            <button
              aria-controls="install-prompt"
              data-copy
              id="copy-prompt"
              type="button"
            >
              Copy prompt
            </button>
          </div>
          <p class="install-note">
            For agents with a different skill location, use their supported
            installation directory. Keep the references and assets together.
          </p>
        </div>
      </section>
    </main>
    <footer>
      <a class="brand" href="/">
        modern web ui
      </a>
      <p>
        Original recipes, open source under MIT.
        <br />
        Independent of Modern CSS. Built with Astro.
      </p>
      <a href="https://modern-css.com/ai/">Modern CSS resources ↗</a>
    </footer>
    <output class="sr-only" id="copy-status"></output>
  </body>
</html>
