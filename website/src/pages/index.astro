---
import CloudHero from "../components/CloudHero.astro";
import BaselineBadge from "../components/BaselineBadge.astro";
import CodeBlock from "../components/CodeBlock.astro";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { auditReport, bandFor } from "../lib/audit-report";
import { recipes } from "../lib/recipes";
import { transformations } from "../lib/transformations";
import "../styles/site.css";
const installPrompt =
  "Use $fewer-parts to build this interface with Tailwind where the project permits it, plus suitable native HTML and web APIs. Preserve the design and check the Tailwind version and browser targets.";
// Nav "Examples" opens the recipe index, which lands on the first example.
const examplesHref = `/recipes/${recipes[0].id}/`;
const coverage = [
  "Layout and containment",
  "Selectors and state",
  "Logical properties",
  "Forms and controls",
  "Dialogs and overlays",
  "Colour and theming",
  "Motion and reduced motion",
  "Native web APIs",
];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      description="A skill for coding agents: build interfaces from native HTML, CSS, and web APIs instead of dependencies, or audit the UI you already have. Runnable demos, before-and-after code, and a scored review."
      title="Fewer Parts — Better interfaces, fewer moving parts"
    />
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>
    <SiteHeader
      installHref="#install"
      links={[
        { href: examplesHref, label: "Examples" },
        { href: "#before-after", label: "Before & after" },
        { href: "#audit", label: "Audit" },
      ]}
    />
    <main id="content">
      <CloudHero />
      <section aria-labelledby="examples-heading" id="examples">
        <div class="section-bar">
          <h2 id="examples-heading">
            See them running <span>RUNNABLE DEMOS</span>
          </h2>
          <p>A sample of the range, live in the page.</p>
        </div>
        <div class="gallery">
          {recipes.map((recipe, i) => (
            <article class:list={["recipe", recipe.id]} id={recipe.id}>
              <div class="recipe-top">
                <code>{recipe.feature}</code>
                <span class="category">{recipe.category}</span>
              </div>
              <div class="demo">
                <iframe
                  loading={i < 2 ? "eager" : "lazy"}
                  sandbox="allow-scripts"
                  srcdoc={recipe.embedded}
                  title={`${recipe.title} demo`}
                  transition:animate="none"
                ></iframe>
              </div>
              <div class="recipe-info">
                <p class="interaction">{recipe.action}</p>
                <h3>
                  <a href={`/recipes/${recipe.id}/`}>{recipe.title}</a>
                  <span aria-hidden="true" class="recipe-go">
                    →
                  </span>
                </h3>
                <p>{recipe.description}</p>
                <div class="recipe-meta">
                  <BaselineBadge status={recipe.status} />
                  <a href={recipe.source}>
                    Support & docs <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
          <aside class="collection-note">
            <span aria-hidden="true" class="note-symbol">
              {"{ }"}
            </span>
            <p class="eyebrow">THE DEMOS ARE THE SAMPLE</p>
            <h3>
              {recipes.length} runnable here.
              <br />
              The platform in the skill.
            </h3>
            <p>
              These ship as assets you can open. Everything else the skill
              reaches by reading Modern CSS, MDN, and Can I use while it works,
              then matching the pattern to your framework, your tokens, and your
              browser targets.
            </p>
            <ul class="coverage">
              {coverage.map((area) => (
                <li>{area}</li>
              ))}
            </ul>
            <a class="text-link" href="https://modern-css.com/cheatsheet/">
              Explore the Modern CSS cheatsheet{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
        <p class="support-note">
          Support reviewed 14 September 2026. Baseline is a starting point;
          check your browser targets and the exact features you use. Newly
          available recipes preserve a usable base.{" "}
          <a href="https://web.dev/baseline">About Baseline ↗</a>
        </p>
      </section>
      <section aria-labelledby="transform-heading" id="before-after">
        <div class="section-bar">
          <h2 id="transform-heading">
            Before and after <span>WHAT IT CHANGES</span>
          </h2>
          <p>Choose a feature to see the replacement.</p>
        </div>
        <fieldset class="switcher">
          <legend class="sr-only">Choose a feature</legend>
          {transformations.map((item, i) => (
            <Fragment>
              <label class="switch">
                <input
                  aria-label={item.feature}
                  checked={i === 0}
                  class="sr-only"
                  name="pattern"
                  type="radio"
                  value={item.id}
                />
                <span>{item.feature}</span>
              </label>
              <article class="pair">
                <div class="pair-head">
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  {item.demo ? (
                    <a class="text-link" href={`/recipes/${item.id}/`}>
                      Try the live demo <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <p class="pair-tag">
                      No demo on this site. Still in range.
                    </p>
                  )}
                </div>
                <div class="pair-code">
                  <CodeBlock
                    id={`before-${item.id}`}
                    label={item.before.label}
                    lang={item.before.lang}
                    source={item.before.source}
                  />
                  <CodeBlock
                    id={`after-${item.id}`}
                    label={item.after.label}
                    lang={item.after.lang}
                    source={item.after.source}
                  />
                </div>
                <p class="pair-note">{item.note}</p>
              </article>
            </Fragment>
          ))}
        </fieldset>
        <p class="support-note">
          Compatibility is decided per project. The skill checks the exact
          syntax or API member against your declared targets before it proposes
          any of this, and keeps a usable base when a feature is new.
        </p>
      </section>
      <section aria-labelledby="audit-heading" class="audit" id="audit">
        <div class="audit-intro">
          <p class="eyebrow">THE OTHER MODE</p>
          <h2 id="audit-heading">
            Or point it at the code
            <br />
            you already have.
          </h2>
          <p>
            Ask for an audit or a review and the skill reads the repository
            instead of writing to it. It establishes scope and your browser
            targets first, scores the dimensions it could actually assess, then
            ranks findings with file evidence, effort, and compatibility risk.
            Nothing changes unless you ask for the fixes separately.
          </p>
          <div class="audit-prompt">
            <p id="audit-prompt-text">{auditReport.prompt}</p>
            <button
              aria-controls="audit-prompt-text"
              data-copy
              id="copy-audit-prompt"
              type="button"
            >
              Copy prompt
            </button>
          </div>
        </div>
        <div class="report">
          <div class="report-bar">
            <span class="preview-label">
              <i aria-hidden="true"></i>Sample report
            </span>
            <p>{auditReport.scope}</p>
          </div>
          <div class="report-score">
            <div>
              <span class="eyebrow">UI MODERNIZATION SCORE</span>
              <strong>
                {auditReport.score}
                <i>/ 5</i>
              </strong>
            </div>
            <div>
              <span class="eyebrow">COVERAGE CONFIDENCE</span>
              <strong class="coverage-value">{auditReport.coverage}</strong>
            </div>
            <p>{auditReport.summary}</p>
          </div>
          {/*
            The table is wider than a phone and its wrapper scrolls. A scroll
            container holding nothing focusable cannot be reached by keyboard
            unless it takes focus itself - newer engines do that on their own,
            the attribute covers the rest.
          */}
          <section
            aria-labelledby="scorecard-caption"
            class="scorecard-scroll"
            tabindex="0"
          >
            <table class="scorecard">
              <caption class="sr-only" id="scorecard-caption">
                Scored dimensions
              </caption>
              <thead>
                <tr>
                  <th scope="col">Dimension</th>
                  <th scope="col">Score</th>
                  <th scope="col">Evidence</th>
                </tr>
              </thead>
              <tbody>
                {auditReport.scorecard.map((row) => (
                  <tr>
                    <th scope="row">{row.dimension}</th>
                    <td class="score-cell">
                      <span
                        class:list={["score", `band-${bandFor(row.score)}`]}
                      >
                        {row.score}
                        <i>/5</i>
                      </span>
                    </td>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
          <p class="legend">
            <span>
              <i aria-hidden="true" class="band-low"></i>0–2 · gaps worth acting
              on
            </span>
            <span>
              <i aria-hidden="true" class="band-mid"></i>3 · sound, mixed
              patterns
            </span>
            <span>
              <i aria-hidden="true" class="band-high"></i>4–5 · strong
            </span>
          </p>
          <ol class="findings">
            {auditReport.findings.map((finding) => (
              <li>
                <div class="finding-top">
                  <span class:list={["group", finding.group.toLowerCase()]}>
                    {finding.group}
                  </span>
                  <code>{finding.id}</code>
                  <h3>{finding.title}</h3>
                </div>
                <p class="evidence">
                  <code>{finding.evidence}</code>
                </p>
                <p>{finding.direction}</p>
                <ul class="measures">
                  <li>Impact {finding.impact}/5</li>
                  <li>Effort {finding.effort}</li>
                  <li>Compat risk {finding.risk}</li>
                  <li>Confidence {finding.confidence}</li>
                </ul>
              </li>
            ))}
          </ol>
          <div class="report-tail">
            <div>
              <h3>Strengths to preserve</h3>
              <p>{auditReport.strengths}</p>
            </div>
            <div>
              <h3>Verification gaps</h3>
              <p>{auditReport.gaps}</p>
            </div>
          </div>
        </div>
        <p class="support-note">
          An illustrative excerpt: the project and the scores are invented, the
          structure is the one the skill follows. The number describes UI
          modernization against your stated constraints — not code quality,
          accessibility conformance, or performance overall.
        </p>
      </section>
      <section
        aria-labelledby="approach-heading"
        class="approach"
        id="approach"
      >
        <div>
          <p class="eyebrow">THE APPROACH</p>
          <h2 id="approach-heading">Modern, with a reason.</h2>
        </div>
        <div class="principles">
          <div>
            <span>01</span>
            <h3>Start with the outcome.</h3>
            <p>
              Choose a native feature when it makes the interface simpler or
              more capable.
            </p>
          </div>
          <div>
            <span>02</span>
            <h3>Keep the whole interaction.</h3>
            <p>
              Preserve keyboard access, application state, and the behavior
              people depend on.
            </p>
          </div>
          <div>
            <span>03</span>
            <h3>Check what really works.</h3>
            <p>
              Read current sources. Test the result. Keep useful fallbacks for
              the browsers you support.
            </p>
          </div>
        </div>
      </section>
      <section aria-labelledby="install-heading" class="install" id="install">
        <div>
          <p class="eyebrow">FOR YOUR CODING AGENT</p>
          <h2 id="install-heading">
            Take the patterns
            <br />
            into your project.
          </h2>
          <p>
            One skill, two modes: build with it, or hand it the UI you already
            have. It reads live references while it works, adapts to your
            styling system, and needs no MCP server or API key.
          </p>
          <a class="download" download href="/downloads/fewer-parts.zip">
            Download the skill <span aria-hidden="true">↓</span>
          </a>
          <a class="repo-link" href="https://github.com/GavinJaynes/skills">
            View repository ↗
          </a>
        </div>
        <div class="install-steps">
          <h3>Install in your project</h3>
          <p>
            Extract the download and copy the complete{" "}
            <code>fewer-parts</code> folder into:
          </p>
          <pre><code>.agents/skills/fewer-parts/</code></pre>
          <p>Then ask your agent:</p>
          <div class="prompt">
            <p id="install-prompt">{installPrompt}</p>
            <button
              aria-controls="install-prompt"
              data-copy
              id="copy-prompt"
              type="button"
            >
              Copy prompt
            </button>
          </div>
          <p class="install-note">
            For agents with a different skill location, use their supported
            installation directory. Keep the references and assets together.
          </p>
        </div>
      </section>
    </main>
    <footer>
      <a class="brand" href="/">
        fewer parts
      </a>
      <p>
        Original recipes, open source under MIT.
        <br />
        Independent of Modern CSS. Built with Astro.
      </p>
      <a href="https://modern-css.com/ai/">Modern CSS resources ↗</a>
    </footer>
    <output class="sr-only" id="copy-status"></output>
  </body>
</html>
