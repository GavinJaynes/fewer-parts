---
import CloudHero from "../components/CloudHero.astro";
import ExampleGallery from "../components/ExampleGallery.astro";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TransformationShowcase from "../components/TransformationShowcase.astro";
import WhatIs from "../components/WhatIs.astro";
import { auditReport, bandFor } from "../lib/audit-report";
import { recipes } from "../lib/recipes";
import "../styles/site.css";
const installPrompt =
  "Use $fewer-parts to deliver the same or better interaction with less project-specific machinery. Preserve the design, behavior, accessibility, browser targets, and existing styling conventions.";
const installCommands = [
  {
    command: "npx skills add GavinJaynes/skills --skill fewer-parts",
    id: "install-command-npx",
    label: "npm / npx",
  },
  {
    command: "pnpm dlx skills add GavinJaynes/skills --skill fewer-parts",
    id: "install-command-pnpm",
    label: "pnpm",
  },
  {
    command: "bunx skills add GavinJaynes/skills --skill fewer-parts",
    id: "install-command-bun",
    label: "Bun",
  },
];
// Nav "Examples" opens the recipe index, which lands on the first example.
const examplesHref = `/recipes/${recipes[0].id}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      description="An installable judgment skill for coding agents. Preserve the experience while removing unnecessary frontend machinery."
      title="Fewer Parts — Same experience, fewer moving parts"
    />
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>
    <SiteHeader
      installHref="#install"
      links={[
        { href: "#what-is", label: "What it is" },
        { href: "#before-after", label: "Decisions" },
        { href: examplesHref, label: "Examples" },
        { href: "#audit", label: "Audit" },
      ]}
    />
    <main id="content">
      <CloudHero />
      <WhatIs />
      <TransformationShowcase />
      <ExampleGallery />
      <section aria-labelledby="audit-heading" class="audit" id="audit">
        <div class="audit-intro">
          <p class="eyebrow">THE OTHER MODE</p>
          <h2 id="audit-heading">
            Or point it at the code
            <br />
            you already have.
          </h2>
          <p>
            Ask for an audit or a review and the skill reads the repository
            instead of writing to it. It establishes scope and your browser
            targets first, scores the dimensions it could actually assess, then
            ranks findings with file evidence, effort, and compatibility risk.
            Nothing changes unless you ask for the fixes separately.
          </p>
          <div class="audit-prompt">
            <p id="audit-prompt-text">{auditReport.prompt}</p>
            <button
              aria-controls="audit-prompt-text"
              data-copy
              id="copy-audit-prompt"
              type="button"
            >
              Copy prompt
            </button>
          </div>
        </div>
        <div class="report">
          <div class="report-bar">
            <span class="preview-label">
              <i aria-hidden="true"></i>Sample report
            </span>
            <p>{auditReport.scope}</p>
          </div>
          <div class="report-score">
            <div>
              <span class="eyebrow">FEWER PARTS SCORE</span>
              <strong>
                {auditReport.score}
                <i>/ 5</i>
              </strong>
            </div>
            <div>
              <span class="eyebrow">COVERAGE CONFIDENCE</span>
              <strong class="coverage-value">{auditReport.coverage}</strong>
            </div>
            <p>{auditReport.summary}</p>
          </div>
          {/*
            The table is wider than a phone and its wrapper scrolls. A scroll
            container holding nothing focusable cannot be reached by keyboard
            unless it takes focus itself - newer engines do that on their own,
            the attribute covers the rest.
          */}
          <section
            aria-labelledby="scorecard-caption"
            class="scorecard-scroll"
            tabindex="0"
          >
            <table class="scorecard">
              <caption class="sr-only" id="scorecard-caption">
                Scored dimensions
              </caption>
              <thead>
                <tr>
                  <th scope="col">Dimension</th>
                  <th scope="col">Score</th>
                  <th scope="col">Evidence</th>
                </tr>
              </thead>
              <tbody>
                {auditReport.scorecard.map((row) => (
                  <tr>
                    <th scope="row">{row.dimension}</th>
                    <td class="score-cell">
                      <span
                        class:list={["score", `band-${bandFor(row.score)}`]}
                      >
                        {row.score}
                        <i>/5</i>
                      </span>
                    </td>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
          <p class="legend">
            <span>
              <i aria-hidden="true" class="band-low"></i>0–2 · gaps worth acting
              on
            </span>
            <span>
              <i aria-hidden="true" class="band-mid"></i>3 · sound, mixed
              patterns
            </span>
            <span>
              <i aria-hidden="true" class="band-high"></i>4–5 · strong
            </span>
          </p>
          <ol class="findings">
            {auditReport.findings.map((finding) => (
              <li>
                <div class="finding-top">
                  <span class:list={["group", finding.group.toLowerCase()]}>
                    {finding.group}
                  </span>
                  <code>{finding.id}</code>
                  <h3>{finding.title}</h3>
                </div>
                <p class="evidence">
                  <code>{finding.evidence}</code>
                </p>
                <p>{finding.direction}</p>
                <p>
                  <strong>Expected reduction:</strong> {finding.reduction}
                </p>
                <ul class="measures">
                  <li>Impact {finding.impact}/5</li>
                  <li>Effort {finding.effort}</li>
                  <li>Compat risk {finding.risk}</li>
                  <li>Confidence {finding.confidence}</li>
                </ul>
              </li>
            ))}
          </ol>
          <div class="report-tail">
            <div>
              <h3>Strengths to preserve</h3>
              <p>{auditReport.strengths}</p>
            </div>
            <div>
              <h3>Verification gaps</h3>
              <p>{auditReport.gaps}</p>
            </div>
          </div>
        </div>
        <p class="support-note">
          An illustrative excerpt: the project and the scores are invented, the
          structure is the one the skill follows. The number describes whether
          the intended experience uses proportionate, project-appropriate
          machinery — not code quality, accessibility conformance, or
          performance overall.
        </p>
      </section>
      <section
        aria-labelledby="approach-heading"
        class="approach"
        id="approach"
      >
        <div>
          <p class="eyebrow">THE APPROACH</p>
          <h2 id="approach-heading">Less machinery, with judgment.</h2>
        </div>
        <div class="principles">
          <div>
            <span>01</span>
            <h3>Start with the outcome.</h3>
            <p>
              Start with the intended feel and behavior, then choose the
              smallest implementation that honestly delivers them.
            </p>
          </div>
          <div>
            <span>02</span>
            <h3>Keep the whole interaction.</h3>
            <p>
              Preserve keyboard access, application state, interruption, and the
              behavior people depend on.
            </p>
          </div>
          <div>
            <span>03</span>
            <h3>Check what really works.</h3>
            <p>
              Read current sources without repeating discovery. Test the result,
              and keep existing machinery when it still earns its keep.
            </p>
          </div>
        </div>
      </section>
      <section aria-labelledby="install-heading" class="install" id="install">
        <div>
          <p class="eyebrow">FOR YOUR CODING AGENT</p>
          <h2 id="install-heading">
            Take the patterns
            <br />
            into your project.
          </h2>
          <p>
            Build, simplify, or audit. It uses platform guidance as evidence,
            adapts the decision to your codebase and styling system, and needs
            no MCP server or API key.
          </p>
          <a class="download" download href="/downloads/fewer-parts.zip">
            Download the skill <span aria-hidden="true">↓</span>
          </a>
          <a class="repo-link" href="https://github.com/GavinJaynes/skills">
            View repository ↗
          </a>
        </div>
        <div class="install-steps">
          <h3>Install with one command</h3>
          <p>
            Run one of these from your project root. The installer finds your
            coding agents and lets you choose where to add the skill.
          </p>
          <div class="install-commands">
            <div
              aria-label="Choose a package manager"
              class="install-command-tabs"
              role="tablist"
            >
              {installCommands.map(({ id, label }, index) => (
                <button
                  aria-controls={`${id}-panel`}
                  aria-selected={index === 0 ? "true" : "false"}
                  class="install-command-tab"
                  id={`${id}-tab`}
                  role="tab"
                  tabindex={index === 0 ? 0 : -1}
                  type="button"
                >
                  {label}
                </button>
              ))}
            </div>
            {installCommands.map(({ command, id, label }, index) => (
              <div
                aria-labelledby={`${id}-tab`}
                class="install-command"
                hidden={index !== 0}
                id={`${id}-panel`}
                role="tabpanel"
              >
                {/* The command is one long unbroken line in a box narrower
                     than it, so it scrolls. A scroll container holding nothing
                     focusable needs to take focus itself to be reachable. */}
                <code id={id} tabindex="0">
                  {command}
                </code>
                <button
                  aria-controls={id}
                  aria-label={`Copy ${label} command`}
                  data-copy
                  type="button"
                >
                  Copy
                </button>
              </div>
            ))}
          </div>
          <p class="manual-install">
            Prefer a manual install? Download the ZIP, extract it, and copy the
            complete <code>fewer-parts</code> folder to{" "}
            <code>.agents/skills/fewer-parts/</code>.
          </p>
          <p>Then ask your agent:</p>
          <div class="prompt">
            <p id="install-prompt">{installPrompt}</p>
            <button
              aria-controls="install-prompt"
              data-copy
              id="copy-prompt"
              type="button"
            >
              Copy prompt
            </button>
          </div>
          <p class="install-note">
            For agents with a different skill location, use their supported
            installation directory. Keep the references and assets together.
          </p>
        </div>
      </section>
    </main>
    <footer>
      <a class="brand" href="/">
        fewer parts
      </a>
      <p>
        Original recipes, open source under MIT.
        <br />
        Independent of Modern CSS. Built with Astro.
        <br />
        Hero rendered with <a href="https://vgpu.sh">vgpu</a>.
      </p>
      <a href="https://modern-css.com/ai/">Modern CSS resources ↗</a>
    </footer>
    <output class="sr-only" id="copy-status"></output>
    <script>
      const selectInstallTab = (tab: HTMLButtonElement, focus = false) => {
        const tablist = tab.closest<HTMLElement>(".install-command-tabs");
        const tabs =
          tablist?.querySelectorAll<HTMLButtonElement>("[role='tab']");
        const commands = tablist?.parentElement;
        if (!tabs || !commands) return;

        for (const candidate of tabs) {
          const selected = candidate === tab;
          candidate.setAttribute("aria-selected", String(selected));
          candidate.tabIndex = selected ? 0 : -1;

          const panelId = candidate.getAttribute("aria-controls");
          const panel = panelId ? commands.querySelector(`#${panelId}`) : null;
          if (panel instanceof HTMLElement) panel.hidden = !selected;
        }

        if (focus) tab.focus();
      };

      document.addEventListener("click", (event) => {
        const target = event.target as Element | null;
        const tab = target?.closest<HTMLButtonElement>(".install-command-tab");
        if (tab) selectInstallTab(tab);
      });

      document.addEventListener("keydown", (event) => {
        const target = event.target as Element | null;
        const tab = target?.closest<HTMLButtonElement>(".install-command-tab");
        if (!tab) return;

        const tabs = Array.from(
          tab
            .closest<HTMLElement>(".install-command-tabs")
            ?.querySelectorAll<HTMLButtonElement>("[role='tab']") ?? []
        );
        const currentIndex = tabs.indexOf(tab);
        let nextIndex = currentIndex;

        if (event.key === "ArrowRight")
          nextIndex = (currentIndex + 1) % tabs.length;
        else if (event.key === "ArrowLeft") {
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else return;

        event.preventDefault();
        const nextTab = tabs[nextIndex];
        if (nextTab) selectInstallTab(nextTab, true);
      });
    </script>
  </body>
</html>
