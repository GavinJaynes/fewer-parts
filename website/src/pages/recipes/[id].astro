---
import CodeBlock from "../../components/CodeBlock.astro";
import SiteHead from "../../components/SiteHead.astro";
import { recipes } from "../../lib/recipes";
import { notesFor, stageWidthFor } from "../../lib/recipe-notes";
import "../../styles/site.css";

export function getStaticPaths() {
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const position = recipes.findIndex((entry) => entry.id === recipe.id);
const notes = notesFor(recipe.id);
const total = String(recipes.length).padStart(2, "0");
const ordinal = String(position + 1).padStart(2, "0");
const next = recipes[(position + 1) % recipes.length];
const previous = recipes[(position - 1 + recipes.length) % recipes.length];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      description={recipe.description}
      title={`${recipe.title} — Modern Web UI`}
      type="article"
    />
  </head>
  <body>
    <a class="skip" href="#demo">
      Skip to the demo
    </a>
    <header class="site-header">
      <a
        aria-label="Modern Web UI home"
        class="brand"
        href="/"
        transition:name="site-brand"
      >
        <span aria-hidden="true" class="brand-mark">
          m
        </span>
        modern web ui<span class="edition">/ skill</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#examples">All examples</a>
        <a class="nav-install" href="/#install">
          Get the skill <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <div class="shell">
      <nav aria-labelledby="collection-heading" class="side">
        <p class="eyebrow" id="collection-heading">
          THE COLLECTION
        </p>
        <ul>
          {recipes.map((entry, index) => (
            <li class:list={["side-item", { current: entry.id === recipe.id }]}>
              <a
                aria-current={entry.id === recipe.id ? "page" : undefined}
                href={`/recipes/${entry.id}/`}
              >
                <span class="side-num">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="side-text">
                  <strong>{entry.title}</strong>
                  <code>{entry.feature}</code>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <main class="detail">
        <section class="detail-head">
          <div>
            <p class="eyebrow">
              {recipe.category} · {ordinal} of {total}
            </p>
            <h1 transition:name={`recipe-title-${recipe.id}`}>
              {recipe.title}
            </h1>
            <p class="lede">{recipe.description}</p>
          </div>
          <div class="detail-meta">
            <code>{recipe.feature}</code>
            <span
              class:list={[
                "support",
                { newly: recipe.status === "Newly available" },
              ]}
            >
              {recipe.status}
            </span>
            {notes.docs && (
              <a class="text-link" href={notes.docs.href}>
                {notes.docs.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </section>

        <section aria-label={`${recipe.title} demo`} class="stage" id="demo">
          <div class="stage-bar">
            <span class="preview-label">
              <i aria-hidden="true"></i>Live demo
            </span>
            <p class="interaction">{recipe.action}</p>
          </div>
          <div
            class="stage-frame"
            style={`--stage:${stageWidthFor(recipe.id)}px`}
          >
            <iframe
              sandbox="allow-scripts"
              srcdoc={recipe.embedded}
              title={`${recipe.title} demo`}
              transition:animate="none"
            ></iframe>
          </div>
        </section>

        <section aria-labelledby="decisions-heading" class="detail-body">
          <article class="explanation">
            <p class="eyebrow">ABOUT THE PATTERN</p>
            <h2>Why this works</h2>
            <p class="why">{recipe.why}</p>
            <h2 id="decisions-heading">Decisions that matter</h2>
            {notes.decisions.length > 0 ? (
              <ul class="decisions">
                {notes.decisions.map((point) => (
                  <li>
                    {point.map((segment) =>
                      segment.isCode ? (
                        <code>{segment.value}</code>
                      ) : (
                        segment.value
                      )
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="lede">No reference notes found for this recipe.</p>
            )}
            <p class="provenance">
              Read from the skill's own reference files at build time.
            </p>
          </article>
          <aside aria-label="Implementation notes" class="implementation">
            <div>
              <span>01</span>
              <h2>Fallback</h2>
              <p>{recipe.fallback}</p>
            </div>
            <div>
              <span>02</span>
              <h2>What to test</h2>
              <p>{recipe.check}</p>
            </div>
            {notes.docs && (
              <a class="docs-card" href={notes.docs.href}>
                <span>Reference</span>
                <strong>{notes.docs.label}</strong>
                <i aria-hidden="true">↗</i>
              </a>
            )}
          </aside>
        </section>

        <section aria-labelledby="source-heading" class="source-section">
          <div class="source-heading">
            <div>
              <p class="eyebrow">COPY, ADAPT, SHIP</p>
              <h2 id="source-heading">The Tailwind example</h2>
            </div>
            <p>Tailwind CSS v4 · adapt utilities to your project tokens</p>
          </div>
          <CodeBlock
            id={`source-${recipe.id}`}
            label="TAILWIND HTML"
            source={recipe.tailwind}
          />
          <details class="source standalone-source">
            <summary>
              View the dependency-free browser demo
              <span aria-hidden="true">+</span>
            </summary>
            <p class="code-caption">
              Vanilla CSS · runnable directly from the skill assets
            </p>
            <CodeBlock
              id={`standalone-source-${recipe.id}`}
              label="STANDALONE HTML"
              source={recipe.html}
            />
          </details>
        </section>

        <nav aria-label="More examples" class="detail-next">
          <a class="previous" href={`/recipes/${previous.id}/`}>
            <span class="eyebrow">← PREVIOUS</span>
            <strong>{previous.title}</strong>
            <code>{previous.feature}</code>
          </a>
          <a class="next" href={`/recipes/${next.id}/`}>
            <span class="eyebrow">NEXT →</span>
            <strong>{next.title}</strong>
            <code>{next.feature}</code>
          </a>
        </nav>
      </main>
    </div>
    <output class="sr-only" id="copy-status"></output>

    <style>
      .shell {
        display: grid;
        grid-template-columns: 232px minmax(0, 1fr);
        gap: 56px;
        align-items: start;
        max-width: 1440px;
        margin-inline: auto;
        padding-inline: clamp(20px, 4.5vw, 72px);
        border-top: 1px solid var(--line);
      }

      /* site.css styles bare `nav` as a horizontal flex row; this one stacks. */
      .side {
        position: sticky;
        top: 24px;
        display: block;
        padding-block: 34px 0;
        font-size: inherit;
        font-weight: 400;
      }

      .side .eyebrow {
        margin-bottom: 14px;
      }

      .side ul {
        display: grid;
        gap: 2px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .side-item a {
        display: grid;
        grid-template-columns: 24px 1fr;
        gap: 10px;
        padding: 10px 12px;
        border-left: 2px solid transparent;
        border-radius: 8px;
      }

      .side-item a:hover {
        background: #f4f7fb;
      }

      .side-num {
        font:
          11px/1.6 ui-monospace,
          monospace;
        color: #9aa5b5;
      }

      .side-text strong {
        display: block;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.35;
      }

      .side-text code {
        display: block;
        margin-top: 3px;
        font-size: 11px;
        color: var(--muted);
      }

      .side-item.current a {
        background: #eef3fd;
        border-left-color: var(--blue);
      }

      .side-item.current .side-text strong {
        color: #1c3f8f;
      }

      .side-item.current .side-num {
        color: var(--blue);
      }

      .detail {
        max-width: none;
        margin-inline: 0;
        padding-block: 44px 80px;
        padding-inline: 0;
      }

      .detail-head {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
        gap: 40px;
        align-items: end;
        padding-bottom: 36px;
      }

      .detail-head h1 {
        font-size: clamp(30px, 3.2vw, 50px);
        font-weight: 560;
        line-height: 1.1;
        letter-spacing: -0.045em;
      }

      .lede {
        max-width: 46ch;
        margin-top: 14px;
        color: var(--muted);
      }

      .detail-meta {
        display: grid;
        justify-items: end;
        justify-self: end;
        gap: 12px;
        padding-bottom: 6px;
        text-align: right;
      }

      .detail-meta code {
        font-size: 15px;
      }

      .stage {
        padding: clamp(14px, 2vw, 22px);
        border: 1px solid #d9e0e9;
        border-radius: 18px;
        margin-bottom: 64px;
        background: #e9eef5;
        box-shadow: 0 22px 54px rgb(23 36 57 / 9%);
      }

      .stage-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: min(100%, var(--stage, 700px));
        margin: 0 auto 13px;
        color: #5c6a7d;
        gap: 20px;
      }

      .preview-label {
        display: inline-flex;
        align-items: center;
        font:
          600 11px/1 ui-monospace,
          monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        gap: 8px;
      }

      .preview-label i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #2c9b66;
        box-shadow: 0 0 0 4px rgb(44 155 102 / 12%);
      }

      .stage .interaction {
        font-size: 12px;
        text-align: right;
      }

      .stage-frame {
        max-width: min(100%, var(--stage, 700px));
        margin-inline: auto;
        overflow: hidden;
        border: 1px solid #cbd4df;
        border-radius: 11px;
        background: #f2f5f9;
        box-shadow:
          0 1px 2px rgb(23 36 57 / 6%),
          0 12px 28px rgb(23 36 57 / 8%);
      }

      .stage-frame iframe {
        display: block;
        width: 100%;
        height: clamp(380px, 52vh, 540px);
        border: 0;
      }

      .detail-body {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.8fr);
        gap: clamp(36px, 6vw, 80px);
        padding-block: 54px 64px;
        border-top: 1px solid var(--line);
      }

      .detail-body h2 {
        margin-bottom: 16px;
        font-size: 18px;
        font-weight: 620;
        letter-spacing: -0.02em;
      }

      .explanation > .eyebrow {
        margin-bottom: 12px;
      }

      .why {
        max-width: 58ch;
        margin-bottom: 36px;
        color: #3d4b5f;
        font-size: clamp(17px, 1.5vw, 20px);
        line-height: 1.55;
      }

      .decisions {
        display: grid;
        gap: 10px;
        margin: 0;
        padding-left: 18px;
      }

      .decisions li {
        font-size: 14px;
        line-height: 1.6;
        color: var(--muted);
      }

      .provenance {
        margin-top: 14px;
        font-size: 12px;
        color: #7a8699;
      }

      .implementation {
        display: grid;
        align-content: start;
        gap: 0;
        border-top: 1px solid var(--line);
      }

      .implementation > div {
        display: grid;
        grid-template-columns: 28px 1fr;
        padding-block: 21px;
        border-bottom: 1px solid var(--line);
        column-gap: 12px;
      }

      .implementation > div > span {
        color: #8d99aa;
        font:
          11px/1.6 ui-monospace,
          monospace;
      }

      .implementation h2 {
        margin-bottom: 5px;
        font-size: 14px;
      }

      .implementation p {
        grid-column: 2;
        color: var(--muted);
        font-size: 13px;
      }

      .docs-card {
        display: grid;
        grid-template-columns: 1fr auto;
        padding: 18px 20px;
        border-radius: 10px;
        margin-top: 22px;
        background: #edf3ff;
        color: #1c3f8f;
        gap: 3px 16px;
      }

      .docs-card span {
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .docs-card strong {
        font-size: 14px;
        font-weight: 620;
      }

      .docs-card i {
        grid-column: 2;
        grid-row: 1 / 3;
        align-self: center;
        font-style: normal;
      }

      .docs-card:hover {
        background: #e2ebfd;
      }

      .source-section {
        min-width: 0;
        padding-block: 54px 12px;
        border-top: 1px solid var(--line);
      }

      .standalone-source {
        margin-top: 24px;
      }

      .source-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        margin-bottom: 20px;
        gap: 24px;
      }

      .source-heading .eyebrow {
        margin-bottom: 9px;
      }

      .source-heading h2 {
        font-size: clamp(24px, 2.5vw, 34px);
        font-weight: 560;
        letter-spacing: -0.035em;
      }

      .source-heading > p {
        color: var(--muted);
        font-size: 12px;
      }

      .detail-next {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 64px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .detail-next a {
        display: grid;
        padding-block: 28px;
        gap: 5px;
      }

      .detail-next .next {
        padding-left: 30px;
        border-left: 1px solid var(--line);
        text-align: right;
      }

      .detail-next strong {
        font-size: 24px;
        font-weight: 550;
        letter-spacing: -0.03em;
      }

      .detail-next a:hover strong {
        color: var(--blue);
      }

      @media (max-width: 1000px) {
        .shell {
          grid-template-columns: minmax(0, 1fr);
          gap: 0;
        }

        .side {
          position: static;
          min-width: 0;
          padding-block: 26px 0;
        }

        .side ul {
          grid-auto-flow: column;
          grid-auto-columns: minmax(160px, 1fr);
          gap: 8px;
          overflow-x: auto;
          padding-bottom: 6px;
        }

        .side-item a {
          border-bottom: 2px solid transparent;
          border-left: 0;
        }

        .side-item.current a {
          border-bottom-color: var(--blue);
        }

        .detail-head,
        .detail-body {
          grid-template-columns: minmax(0, 1fr);
          gap: 24px;
        }

        .detail-meta {
          justify-items: start;
          justify-self: start;
          text-align: left;
        }
      }

      @media (max-width: 620px) {
        .detail {
          padding-block: 32px 56px;
        }

        .stage {
          margin-inline: -8px;
          margin-bottom: 44px;
        }

        .stage-bar,
        .source-heading {
          align-items: start;
          flex-direction: column;
          gap: 7px;
        }

        .stage .interaction {
          text-align: left;
        }

        .stage-frame iframe {
          height: 430px;
        }

        .detail-next strong {
          font-size: 18px;
        }

        .detail-next .next {
          padding-left: 18px;
        }
      }
    </style>
  </body>
</html>
