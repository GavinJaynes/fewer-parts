---
import BaselineBadge from "../../components/BaselineBadge.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { recipes } from "../../lib/recipes";
import { notesFor, stageWidthFor } from "../../lib/recipe-notes";
import { transformationFor } from "../../lib/transformations";
import "../../styles/site.css";

export function getStaticPaths() {
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const position = recipes.findIndex((entry) => entry.id === recipe.id);
const notes = notesFor(recipe.id);
const total = String(recipes.length).padStart(2, "0");
const ordinal = String(position + 1).padStart(2, "0");
const next = recipes[(position + 1) % recipes.length];
const previous = recipes[(position - 1 + recipes.length) % recipes.length];
const transformation = transformationFor(recipe.id);
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      description={recipe.description}
      title={`${recipe.title} — Fewer Parts`}
      type="article"
    />
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>
    <SiteHeader
      installHref="/#install"
      links={[{ href: "/#examples", label: "All examples" }]}
    />

    <div class="shell">
      <nav aria-labelledby="worked-examples-heading" class="side">
        <p class="eyebrow" id="worked-examples-heading">
          WORKED EXAMPLES
        </p>
        {/*
            The two state attributes are only ever written by the drag script,
            never by the build, and are declared here as the element's own
            record of the states it can be in - which is also what lets the
            unused-selector rule see that the CSS keyed off them is live.
          */}
        <ul data-dragging={undefined} data-overflowing={undefined} data-rail>
          {recipes.map((entry, index) => (
            <li class:list={["side-item", { current: entry.id === recipe.id }]}>
              <a
                aria-current={entry.id === recipe.id ? "page" : undefined}
                href={`/recipes/${entry.id}/`}
              >
                <span class="side-num">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="side-text">
                  <strong>{entry.title}</strong>
                  <code>{entry.feature}</code>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <main class="detail" id="content">
        <section class="detail-head">
          <div>
            <p class="eyebrow">
              {recipe.category} · {ordinal} of {total}
            </p>
            <h1 transition:name="recipe-title">{recipe.title}</h1>
            <p class="lede">{recipe.description}</p>
          </div>
          <div class="detail-meta">
            <code>{recipe.feature}</code>
            <BaselineBadge status={recipe.status} />
            {notes.docs && (
              <a class="text-link" href={notes.docs.href}>
                {notes.docs.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </section>

        {transformation && (
          <dl class="recipe-value" aria-label="What this decision changes">
            <div>
              <dt>Experience kept</dt>
              <dd>{transformation.preserves}</dd>
            </div>
            <div>
              <dt>Machinery removed</dt>
              <dd>{transformation.removes}</dd>
            </div>
            <div>
              <dt>Decision</dt>
              <dd>{transformation.decision}</dd>
            </div>
          </dl>
        )}

        <section aria-label={`${recipe.title} demo`} class="stage" id="demo">
          <div class="stage-bar">
            <span class="preview-label">
              <i aria-hidden="true"></i>Live demo
            </span>
            <p class="interaction">{recipe.action}</p>
          </div>
          <div
            class="stage-frame"
            style={`--stage:${stageWidthFor(recipe.id)}px`}
          >
            <iframe
              sandbox="allow-scripts"
              srcdoc={recipe.embedded}
              title={`${recipe.title} demo`}
              transition:animate="none"
            ></iframe>
          </div>
        </section>

        {transformation && (
          <section
            aria-labelledby="reduction-heading"
            class="recipe-comparison"
          >
            <div class="comparison-heading">
              <p class="eyebrow">THE REDUCTION</p>
              <h2 id="reduction-heading">Same outcome. Less to coordinate.</h2>
              <p>{transformation.summary}</p>
            </div>
            <div class="pair-code">
              <CodeBlock
                id={`detail-before-${recipe.id}`}
                label={transformation.before.label}
                lang={transformation.before.lang}
                source={transformation.before.source}
              />
              <CodeBlock
                id={`detail-after-${recipe.id}`}
                label={transformation.after.label}
                lang={transformation.after.lang}
                source={transformation.after.source}
              />
            </div>
            <p class="pair-note">{transformation.note}</p>
          </section>
        )}

        <section aria-labelledby="decisions-heading" class="detail-body">
          <article class="explanation">
            <p class="eyebrow">ABOUT THE PATTERN</p>
            <h2>Why this works</h2>
            <p class="why">{recipe.why}</p>
            <h2 id="decisions-heading">Decisions that matter</h2>
            {notes.decisions.length > 0 ? (
              <ul class="decisions">
                {notes.decisions.map((point) => (
                  <li>
                    {point.map((segment) =>
                      segment.isCode ? (
                        <code>{segment.value}</code>
                      ) : (
                        segment.value
                      )
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="lede">No reference notes found for this recipe.</p>
            )}
            <p class="provenance">
              Read from the skill's own reference files at build time.
            </p>
          </article>
          <aside aria-label="Implementation notes" class="implementation">
            <div>
              <span>01</span>
              <h2>Fallback</h2>
              <p>{recipe.fallback}</p>
            </div>
            <div>
              <span>02</span>
              <h2>What to test</h2>
              <p>{recipe.check}</p>
            </div>
            {notes.docs && (
              <a class="docs-card" href={notes.docs.href}>
                <span>Reference</span>
                <strong>{notes.docs.label}</strong>
                <i aria-hidden="true">↗</i>
              </a>
            )}
          </aside>
        </section>

        <section aria-labelledby="source-heading" class="source-section">
          <div class="source-heading">
            <div>
              <p class="eyebrow">COPY, ADAPT, SHIP</p>
              <h2 id="source-heading">The dependency-free implementation</h2>
            </div>
            <p>HTML, CSS, and the JavaScript the interaction actually needs</p>
          </div>
          <CodeBlock
            id={`standalone-source-${recipe.id}`}
            label="STANDALONE HTML"
            source={recipe.html}
          />
          <details class="source standalone-source">
            <summary>
              Using Tailwind CSS v4 already? View the adapted example
              <span aria-hidden="true">+</span>
            </summary>
            <p class="code-caption">
              Optional integration · adapt utilities to your project tokens
            </p>
            <CodeBlock
              id={`tailwind-source-${recipe.id}`}
              label="TAILWIND HTML"
              source={recipe.tailwind}
            />
          </details>
        </section>

        <nav aria-label="More examples" class="detail-next">
          <a class="previous" href={`/recipes/${previous.id}/`}>
            <span class="eyebrow">← PREVIOUS</span>
            <strong>{previous.title}</strong>
            <code>{previous.feature}</code>
          </a>
          <a class="next" href={`/recipes/${next.id}/`}>
            <span class="eyebrow">NEXT →</span>
            <strong>{next.title}</strong>
            <code>{next.feature}</code>
          </a>
        </nav>
      </main>
    </div>
    <output class="sr-only" id="copy-status"></output>

    <script>
      import { mountDragRail, revealCurrent } from "../../scripts/drag-rail";

      let dispose: (() => void) | undefined;

      const setup = () => {
        dispose?.();
        dispose = undefined;

        const rail = document.querySelector<HTMLElement>("[data-rail]");
        if (!rail) return;

        dispose = mountDragRail(rail);
        revealCurrent(rail);
      };

      document.addEventListener("astro:page-load", setup);
      document.addEventListener("astro:before-swap", () => dispose?.());
    </script>
    <style>
      /* The sub-nav's scroll affordance, with no JavaScript in it. Registering
         the two lengths is what makes them animatable at all; a scroll-progress
         timeline then grows each fade only while there is still list hidden
         past that edge, so a strip pushed hard against its end reads as ended
         rather than as holding something back. With no overflow there is no
         timeline, the animations never apply, and both lengths rest at the 0px
         they were registered with. */
      @property --rail-fade-start {
        syntax: "<length>";
        inherits: false;
        initial-value: 0px;
      }

      @property --rail-fade-end {
        syntax: "<length>";
        inherits: false;
        initial-value: 0px;
      }

      @keyframes rail-fade-start {
        from {
          --rail-fade-start: 0px;
        }

        to {
          --rail-fade-start: var(--rail-fade);
        }
      }

      @keyframes rail-fade-end {
        from {
          --rail-fade-end: var(--rail-fade);
        }

        to {
          --rail-fade-end: 0px;
        }
      }

      /* These page styles were unlayered, which put every one of them ahead of
         the whole of site.css whatever their specificity. Declaring the layer
         they belong to puts them back under the same rules as everything else. */
      @layer components {
        .shell {
          display: grid;
          grid-template-columns: 14.5rem minmax(0, 1fr);
          gap: 56px;
          align-items: start;
          max-width: var(--page-max);
          margin-inline: auto;
          padding-inline: var(--page-gutter);
          border-top: 1px solid var(--line);
        }

        .side {
          position: sticky;
          top: var(--top-clearance);
          padding-block: 34px 0;
        }

        .side .eyebrow {
          margin-bottom: 14px;
        }

        .side ul {
          display: grid;
          gap: 2px;
          margin: 0;
          padding: 0;
          list-style: none;
        }

        .side-item a {
          display: grid;
          grid-template-columns: 1.5rem 1fr;
          gap: 10px;
          padding: 10px 12px;
          border-left: 2px solid transparent;
          border-radius: 8px;
        }

        .side-item a:hover {
          background: #f4f7fb;
        }

        .side-num {
          font:
            0.6875rem/1.6 ui-monospace,
            monospace;
          /* --muted rather than --quiet: the row tints under hover and for the
           current item are dark enough to put --quiet below the floor. */
          color: var(--muted);
        }

        .side-text strong {
          display: block;
          font-size: 0.8125rem;
          font-weight: 600;
          line-height: 1.35;
        }

        .side-text code {
          display: block;
          margin-top: 3px;
          font-size: 0.6875rem;
          color: var(--muted);
        }

        .side-item.current a {
          background: #eef3fd;
          border-left-color: var(--blue);
        }

        .side-item.current .side-text strong {
          color: #1c3f8f;
        }

        .side-item.current .side-num {
          color: var(--blue);
        }

        .detail {
          max-width: none;
          margin-inline: 0;
          padding-block: 44px 80px;
          padding-inline: 0;
        }

        .detail-head {
          display: grid;
          grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
          gap: 40px;
          align-items: end;
          padding-bottom: 36px;
        }

        .detail-head h1 {
          font-size: clamp(1.875rem, 3.2vw, 3.125rem);
          font-weight: 560;
          line-height: 1.1;
          letter-spacing: -0.045em;
        }

        .lede {
          max-width: 46ch;
          margin-top: 14px;
          color: var(--muted);
        }

        .detail-meta {
          display: grid;
          justify-items: end;
          justify-self: end;
          gap: 12px;
          padding-bottom: 6px;
          text-align: right;
        }

        .detail-meta code {
          font-size: 0.9375rem;
        }

        .recipe-value {
          display: grid;
          overflow: hidden;
          margin: 0 0 30px;
          border: 1px solid var(--line);
          border-radius: 12px;
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .recipe-value > div {
          padding: 16px 18px;
        }

        .recipe-value > div + div {
          border-left: 1px solid var(--line);
        }

        .recipe-value dt {
          color: var(--quiet);
          font:
            0.6875rem/1.5 ui-monospace,
            monospace;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        .recipe-value dd {
          margin-top: 7px;
          color: #36445a;
          font-size: 0.8125rem;
        }

        .stage {
          padding: clamp(14px, 2vw, 22px);
          border: 1px solid #d9e0e9;
          border-radius: 18px;
          margin-bottom: 64px;
          background: #e9eef5;
          box-shadow: 0 22px 54px rgb(23 36 57 / 9%);
        }

        .stage-bar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          max-width: min(100%, var(--stage, 700px));
          margin: 0 auto 13px;
          color: #5c6a7d;
          gap: 20px;
        }

        /* The stage tint is dark enough that --muted lands at 4.3:1 on it. The
         bar already picks a colour that clears the floor here; inherit it. */
        .stage .interaction {
          color: inherit;
          font-size: 0.75rem;
          text-align: right;
        }

        .stage-frame {
          max-width: min(100%, var(--stage, 700px));
          margin-inline: auto;
          overflow: hidden;
          border: 1px solid #cbd4df;
          border-radius: 11px;
          background: #f2f5f9;
          box-shadow:
            0 1px 2px rgb(23 36 57 / 6%),
            0 12px 28px rgb(23 36 57 / 8%);
        }

        .stage-frame iframe {
          display: block;
          width: 100%;
          height: clamp(380px, 52vh, 540px);
          border: 0;
        }

        .recipe-comparison {
          padding-block: 54px 64px;
          border-top: 1px solid var(--line);
        }

        .comparison-heading {
          display: grid;
          max-width: 52rem;
          margin-bottom: 24px;
          gap: 9px;
        }

        .comparison-heading .eyebrow {
          margin-bottom: 0;
        }

        .comparison-heading h2 {
          font-size: clamp(1.5rem, 2.5vw, 2.125rem);
          font-weight: 560;
          letter-spacing: -0.035em;
        }

        .comparison-heading > p:last-child {
          color: var(--muted);
        }

        .recipe-comparison .pair-code {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .recipe-comparison .pair-note {
          margin-top: 18px;
        }

        .detail-body {
          display: grid;
          grid-template-columns: minmax(0, 1.35fr) minmax(17.5rem, 0.8fr);
          gap: clamp(36px, 6vw, 80px);
          padding-block: 54px 64px;
          border-top: 1px solid var(--line);
        }

        .detail-body h2 {
          margin-bottom: 16px;
          font-size: 1.125rem;
          font-weight: 620;
          letter-spacing: -0.02em;
        }

        .explanation > .eyebrow {
          margin-bottom: 12px;
        }

        .why {
          max-width: 58ch;
          margin-bottom: 36px;
          color: #3d4b5f;
          font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
          line-height: 1.55;
        }

        .decisions {
          display: grid;
          gap: 10px;
          margin: 0;
          padding-left: 18px;
        }

        .decisions li {
          font-size: 0.875rem;
          line-height: 1.6;
          color: var(--muted);
        }

        .provenance {
          margin-top: 14px;
          font-size: 0.75rem;
          color: var(--quiet);
        }

        .implementation {
          display: grid;
          align-content: start;
          gap: 0;
          border-top: 1px solid var(--line);
        }

        .implementation > div {
          display: grid;
          grid-template-columns: 1.75rem 1fr;
          padding-block: 21px;
          border-bottom: 1px solid var(--line);
          column-gap: 12px;
        }

        .implementation > div > span {
          color: var(--quiet);
          font:
            0.6875rem/1.6 ui-monospace,
            monospace;
        }

        .implementation h2 {
          margin-bottom: 5px;
          font-size: 0.875rem;
        }

        .implementation p {
          grid-column: 2;
          color: var(--muted);
          font-size: 0.8125rem;
        }

        .docs-card {
          display: grid;
          grid-template-columns: 1fr auto;
          padding: 18px 20px;
          border-radius: 10px;
          margin-top: 22px;
          background: #edf3ff;
          color: #1c3f8f;
          gap: 3px 16px;
        }

        .docs-card span {
          font-size: 0.6875rem;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        .docs-card strong {
          font-size: 0.875rem;
          font-weight: 620;
        }

        .docs-card i {
          grid-column: 2;
          grid-row: 1 / 3;
          align-self: center;
          font-style: normal;
        }

        .docs-card:hover {
          background: #e2ebfd;
        }

        .source-section {
          min-width: 0;
          padding-block: 54px 12px;
          border-top: 1px solid var(--line);
        }

        .standalone-source {
          margin-top: 24px;
        }

        .source-heading {
          display: flex;
          align-items: end;
          justify-content: space-between;
          margin-bottom: 20px;
          gap: 24px;
        }

        .source-heading .eyebrow {
          margin-bottom: 9px;
        }

        .source-heading h2 {
          font-size: clamp(1.5rem, 2.5vw, 2.125rem);
          font-weight: 560;
          letter-spacing: -0.035em;
        }

        .source-heading > p {
          color: var(--muted);
          font-size: 0.75rem;
        }

        .detail-next {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          margin-top: 64px;
          border-top: 1px solid var(--line);
          border-bottom: 1px solid var(--line);
        }

        .detail-next a {
          display: grid;
          padding-block: 28px;
          gap: 5px;
        }

        .detail-next .next {
          padding-left: 30px;
          border-left: 1px solid var(--line);
          text-align: right;
        }

        .detail-next strong {
          font-size: 1.5rem;
          font-weight: 550;
          letter-spacing: -0.03em;
        }

        .detail-next a:hover strong {
          color: var(--blue);
        }

        @media (width <= 1000px) {
          .shell {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
          }

          .side {
            position: static;
            min-width: 0;
            padding-block: 26px 0;
          }

          .side ul {
            --rail-fade: 28px;

            grid-auto-flow: column;
            grid-auto-columns: minmax(10rem, 1fr);
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 6px;
            overscroll-behavior-inline: contain;
          }

          /* The scrollbar is the only thing currently saying the strip scrolls,
           so it goes away exactly where the thing replacing it is understood
           and not one browser earlier. */
          @supports (animation-timeline: scroll()) {
            .side ul {
              padding-bottom: 2px;
              scrollbar-width: none;
              animation:
                rail-fade-start linear both,
                rail-fade-end linear both;
              animation-range:
                0px var(--rail-fade),
                calc(100% - var(--rail-fade)) 100%;
              animation-timeline: scroll(self inline);
              mask-image: linear-gradient(
                to right,
                transparent 0,
                #000 var(--rail-fade-start),
                #000 calc(100% - var(--rail-fade-end)),
                transparent 100%
              );
            }
          }

          /* Set by the drag script, and only once the list really is wider than
           its box - the cursor should not promise movement that is not there.
           The rule matches the markup as authored, so it cannot see either
           attribute; both are added at runtime. */
          .side ul[data-overflowing] {
            cursor: grab;
          }

          .side ul[data-dragging],
          .side ul[data-dragging] a {
            cursor: grabbing;
            user-select: none;
          }

          .side-item a {
            border-bottom: 2px solid transparent;
            border-left: 0;
          }

          .side-item.current a {
            border-bottom-color: var(--blue);
          }

          .detail-head,
          .detail-body {
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
          }

          .recipe-value {
            grid-template-columns: 1fr;
          }

          .recipe-value > div + div {
            border-top: 1px solid var(--line);
            border-left: 0;
          }

          .detail-meta {
            justify-items: start;
            justify-self: start;
            text-align: left;
          }
        }

        @media (width <= 620px) {
          .detail {
            padding-block: 32px 56px;
          }

          .stage {
            margin-inline: -8px;
            margin-bottom: 44px;
          }

          .stage-bar,
          .source-heading {
            align-items: start;
            flex-direction: column;
            gap: 7px;
          }

          .stage .interaction {
            text-align: left;
          }

          .stage-frame iframe {
            height: 430px;
          }

          .recipe-comparison .pair-code {
            grid-template-columns: 1fr;
          }

          .detail-next strong {
            font-size: 1.125rem;
          }

          .detail-next .next {
            padding-left: 18px;
          }
        }
      }
    </style>
  </body>
</html>
