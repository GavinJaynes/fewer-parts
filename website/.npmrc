# eslint-plugin-astro@3 requires eslint>=10 and peers eslint-plugin-jsx-a11y>=6.10.2,
# but jsx-a11y@6.10.2 (its latest) still declares a peer range capping at eslint@9.
# The rules run correctly on eslint@10 — the range is stale, not the code — so peer
# resolution is relaxed here. Remove this once jsx-a11y publishes eslint@10 support.
legacy-peer-deps=true
